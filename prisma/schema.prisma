// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Weapon {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cases     Case[]
}

model CrimeClassification {
  id        Int      @id @default(autoincrement())
  name      String
  cases     Case[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReportingPerson {
  id           Int      @id @default(autoincrement())
  name         String
  idNo         String
  phoneNumber  String
  relationship String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  Case         Case[]
}

model Case {
  id                   Int                   @id @default(autoincrement())
  rciNo                String
  obNo                 String
  weapons              Weapon[]
  crimeClassifications CrimeClassification[]
  reportingPerson      ReportingPerson       @relation(fields: [reportingPersonId], references: [id])
  occurrencePlace      String
  victim               PersonalInformation   @relation("CaseToVictim", fields: [victimId], references: [id])
  suspect              PersonalInformation   @relation("CaseToSuspect", fields: [suspectId], references: [id])

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  reportingPersonId Int
  victimId          Int
  suspectId         Int

  @@map("cases")
}

model PersonalInformation {
  id               Int             @id @default(autoincrement())
  nationalId       String          @unique
  nationalIdType   NationalIdType?
  surname          String?
  middleName       String?
  firstName        String?
  gender           Gender?
  phoneNumber      String?
  email            String?
  dateOfBirth      DateTime?
  nationality      String?
  meritalStatus    MeritalStatus?
  occupation       String?
  education        Education?
  placeOfBirth     String?
  areaChief        String?
  placeOfResidence String?
  headMan          String?
  principalChief   String?
  district         String?
  nextOfKin        String?
  nextOfKinPhone   String?
  victimCases      Case[]          @relation("CaseToVictim")
  suspectCases     Case[]          @relation("CaseToSuspect")
}

enum Education {
  NONE
  PRIMARY
  SECONDARY
  TERTIARY
  OTHER
}

enum MeritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  OTHER
}

enum NationalIdType {
  ID_CARD
  DRIVING_LICENSE
  PASSPORT
  VOTERS_CARD
  OTHER
  NONE
}

enum Gender {
  MALE
  FEAMLE
  OTHER
}
