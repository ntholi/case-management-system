// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

// generator zod {
//   provider = "zod-prisma-types"
// }

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id             String         @id @default(cuid())
  firstName      String?        @map("first_name")
  lastName       String?        @map("last_name")
  role           Role           @default(USER)
  email          String         @unique
  emailVerified  DateTime?      @map("email_verified")
  image          String?
  hashedPassword String?        @map("hashed_password")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  policeStation  PoliceStation? @relation(fields: [policeStationId], references: [id])

  accounts        Account[]
  sessions        Session[]
  policeStationId String?   @map("police_station_id")

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Weapon {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  cases     Case[]

  @@map("weapons")
}

model CrimeClassification {
  id        String   @id @default(cuid())
  name      String   @unique
  cases     Case[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("crime_classifications")
}

model PoliceStation {
  id        String   @id @default(cuid())
  name      String
  district  District
  cases     Case[]
  users     User[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([name, district])
  @@map("police_stations")
}

model ReportingPerson {
  id           String   @id @default(cuid())
  name         String?
  nationalId   String?  @map("national_id")
  phoneNumber  String?  @map("phone_number")
  relationship String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  case         Case?

  @@map("reporting_persons")
}

model Case {
  id                   String                @id @default(cuid())
  rciNo                String                @unique @map("rci_no")
  obNo                 String                @unique @map("ob_no")
  weapons              Weapon[]
  crimeClassifications CrimeClassification[]
  policeStation        PoliceStation         @relation(fields: [policeStationId], references: [id])
  occurrencePlace      String?               @map("occurrence_place")
  victims              PersonalInformation[] @relation("CaseToVictim")
  suspects             PersonalInformation[] @relation("CaseToSuspect")
  modusOperandi        String?               @map("modus_operandi")
  modusOperandiDetails String?               @map("modus_operandi_details")
  modusOperandiLinked  ModusOperandiLined?   @map("modus_operandi_linked")
  dateOfOccurrence     DateTime?             @map("date_of_occurrence")
  dateOfReport         DateTime?             @map("date_of_report")
  reportingPerson      ReportingPerson       @relation(fields: [reportingPersonId], references: [id])
  caseStatus           CaseStatus?
  disability           String?
  whatHappened         String?               @map("what_happened")
  published            Boolean               @default(false)
  policeStationId      String                @map("police_station_id")
  reportingPersonId    String                @unique @map("reporting_person_id")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  @@map("cases")
}

model CaseStatus {
  id               String           @id @default(cuid())
  crNumber         Int              @unique @default(autoincrement()) @map("cr_number")
  policeCaseStatus PoliceCaseStatus @default(PENDING_ALLOCATION) @map("police_case_status")
  courtCaseStatus  CourtCaseStatus? @map("court_case_status")
  case             Case             @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId           String           @unique
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@map("case_statuses")
}

model PersonalInformation {
  id               String         @id @default(cuid())
  nationalId       String         @unique @map("national_id")
  nationalIdType   String         @map("national_id_type")
  surname          String?
  middleName       String?        @map("middle_name")
  firstName        String?        @map("first_name")
  gender           Gender?
  phoneNumber      String?        @map("phone_number")
  email            String?
  dateOfBirth      DateTime?      @map("date_of_birth")
  nationality      String?
  maritalStatus    MaritalStatus? @map("marital_status")
  occupation       String?
  education        Education?
  placeOfBirth     String?        @map("place_of_birth")
  areaChief        String?        @map("area_chief")
  placeOfResidence String?        @map("place_of_residence")
  headMan          String?        @map("head_man")
  principalChief   String?        @map("principal_chief")
  district         String?
  nextOfKin        String?        @map("next_of_kin")
  nextOfKinPhone   String?        @map("next_of_kin_phone")
  victimCases      Case[]         @relation("CaseToVictim")
  suspectCases     Case[]         @relation("CaseToSuspect")
  description      String?
  physicalAddress  String?        @map("physical_address")
  villageChief     String?        @map("village_chief")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  @@map("personal_informations")
}

enum Education {
  NONE
  PRIMARY
  SECONDARY
  TERTIARY
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  OTHER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ModusOperandiLined {
  YES
  NO
  UNKNOWN
}

enum Role {
  ADMIN
  USER
}

enum District {
  BEREA
  BUTHA_BUTHE
  LERIBE
  MASERU_URBAN
  MASERU_RURAL
  MAFETENG
  MOHALES_HOEK
  MOKHOTLONG
  QACHAS_NEK
  QUTHING
  THABA_TSEKA
}

enum PoliceCaseStatus {
  PENDING_ALLOCATION
  PENDING_INVESTIGATION
  PENDING_ARREST
  PENDING_STATEMENT
  AWAITS_EXHIBIT
}

enum CourtCaseStatus {
  REMANDED_FF_INVESTIGATION
  PENDING_HEARING
  PENDING_SET_DOWN
  DIVERTED
  PART_HEARD
}
