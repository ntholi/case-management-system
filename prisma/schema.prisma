// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

// generator zod {
//   provider = "zod-prisma-types"
// }

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id             String         @id @default(cuid())
  firstName      String?        @map("first_name")
  lastName       String?        @map("last_name")
  role           Role           @default(USER)
  email          String         @unique
  emailVerified  DateTime?      @map("email_verified")
  image          String?
  hashedPassword String?        @map("hashed_password")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  policeStation  PoliceStation? @relation(fields: [policeStationId], references: [id])

  accounts        Account[]
  sessions        Session[]
  policeStationId String?

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Weapon {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cases     Case[]

  @@map("weapons")
}

model CrimeClassification {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cases     Case[]

  @@map("crime_classifications")
}

model PoliceStation {
  id        String   @id @default(cuid())
  name      String
  district  District
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cases     Case[]
  users     User[]

  @@unique([name, district])
  @@map("police_stations")
}

model ReportingPerson {
  id           Int      @id @default(autoincrement())
  name         String?
  idNo         String?
  phoneNumber  String?
  relationship String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  case         Case?

  @@map("reporting_persons")
}

model Case {
  id                   Int                   @id @default(autoincrement())
  rciNo                String                @unique
  obNo                 String
  weapons              Weapon[]
  crimeClassifications CrimeClassification[]
  policeStation        PoliceStation         @relation(fields: [policeStationId], references: [id])
  occurrencePlace      String?
  victims              PersonalInformation[] @relation("CaseToVictim")
  suspects             PersonalInformation[] @relation("CaseToSuspect")
  modusOperandi        String?
  modusOperandiDetails String?
  modusOperandiLinked  ModusOperandiLined?
  dateOfOccurrence     DateTime?
  dateOfReport         DateTime?
  policeStationId      String
  reportingPerson      ReportingPerson       @relation(fields: [reportingPersonId], references: [id])
  reportingPersonId    Int                   @unique
  caseStatus           CaseStatus?
  published            Boolean               @default(false)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@map("cases")
}

model CaseStatus {
  id               String           @id @default(cuid())
  crNumber         Int              @unique @default(autoincrement()) @map("cr_number")
  policeCaseStatus PoliceCaseStatus @default(PENDING_ALLOCATION) @map("police_case_status")
  courtCaseStatus  CourtCaseStatus? @map("court_case_status")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  case             Case             @relation(fields: [caseId], references: [id])
  caseId           Int              @unique

  @@map("case_statuses")
}

model PersonalInformation {
  id               Int            @id @default(autoincrement())
  nationalId       String         @unique
  nationalIdType   String
  surname          String?
  middleName       String?
  firstName        String?
  gender           Gender?
  phoneNumber      String?
  email            String?
  dateOfBirth      DateTime?
  nationality      String?
  maritalStatus    MaritalStatus?
  occupation       String?
  education        Education?
  placeOfBirth     String?
  areaChief        String?
  placeOfResidence String?
  headMan          String?
  principalChief   String?
  district         String?
  nextOfKin        String?
  nextOfKinPhone   String?
  victimCases      Case[]         @relation("CaseToVictim")
  suspectCases     Case[]         @relation("CaseToSuspect")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("personal_informations")
}

enum Education {
  NONE
  PRIMARY
  SECONDARY
  TERTIARY
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  OTHER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ModusOperandiLined {
  YES
  NO
  UNKNOWN
}

enum Role {
  ADMIN
  USER
}

enum District {
  BEREA
  BUTHA_BUTHE
  LERIBE
  MASERU_URBAN
  MASERU_RURAL
  MAFETENG
  MOHALES_HOEK
  MOKHOTLONG
  QACHAS_NEK
  QUTHING
  THABA_TSEKA
}

enum PoliceCaseStatus {
  PENDING_ALLOCATION
  PENDING_INVESTIGATION
  PENDING_ARREST
  PENDING_STATEMENT
  AWAITS_EXHIBIT
}

enum CourtCaseStatus {
  REMANDED_FF_INVESTIGATION
  PENDING_HEARING
  PENDING_SET_DOWN
  DIVERTED
  PART_HEARD
}
