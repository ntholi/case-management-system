// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

// generator zod {
//   provider = "zod-prisma-types"
// }

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id             String    @id @default(cuid())
  firstName      String?   @map("first_name")
  lastName       String?   @map("last_name")
  role           Role      @default(USER)
  email          String    @unique
  emailVerified  DateTime? @map("email_verified")
  image          String?
  hashedPassword String?   @map("hashed_password")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Weapon {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cases     Case[]

  @@map("weapons")
}

model CrimeClassification {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cases     Case[]

  @@map("crime_classifications")
}

model ReportingPerson {
  id           Int      @id @default(autoincrement())
  name         String?
  idNo         String?
  phoneNumber  String?
  relationship String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  Case         Case[]

  @@map("reporting_persons")
}

model Case {
  id                   Int                   @id @default(autoincrement())
  rciNo                String
  obNo                 String
  weapons              Weapon[]
  crimeClassifications CrimeClassification[]
  reportingPerson      ReportingPerson       @relation(fields: [reportingPersonId], references: [id])
  occurrencePlace      String?
  district             Destrict?
  victim               PersonalInformation?  @relation("CaseToVictim", fields: [victimId], references: [id])
  suspect              PersonalInformation?  @relation("CaseToSuspect", fields: [suspectId], references: [id])
  modusOperandi        String?
  modusOperandiDetails String?
  modusOperandiLinked  ModusOperandiLined?
  dateOfOccurrence     DateTime?
  dateOfReport         DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  reportingPersonId Int
  victimId          Int
  suspectId         Int

  @@map("cases")
}

model PersonalInformation {
  id               Int             @id @default(autoincrement())
  nationalId       String          @unique
  nationalIdType   NationalIdType?
  surname          String?
  middleName       String?
  firstName        String?
  gender           Gender?
  phoneNumber      String?
  email            String?
  dateOfBirth      DateTime?
  nationality      String?
  meritalStatus    MeritalStatus?
  occupation       String?
  education        Education?
  placeOfBirth     String?
  areaChief        String?
  placeOfResidence String?
  headMan          String?
  principalChief   String?
  district         String?
  nextOfKin        String?
  nextOfKinPhone   String?
  victimCases      Case[]          @relation("CaseToVictim")
  suspectCases     Case[]          @relation("CaseToSuspect")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("personal_informations")
}

enum Education {
  NONE
  PRIMARY
  SECONDARY
  TERTIARY
  OTHER
}

enum MeritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  OTHER
}

enum NationalIdType {
  ID_CARD
  DRIVING_LICENSE
  PASSPORT
  VOTERS_CARD
  OTHER
  NONE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ModusOperandiLined {
  YES
  NO
  UNKNOWN
}

enum Role {
  ADMIN
  USER
}

enum Destrict {
  BEREA
  BUTHA_BUTHE
  LERIBE
  MASERU_URBAN
  MASERU_RURAL
  MAFETENG
  MOHALES_HOEK
  MOKHOTLONG
  QACHAS_NEK
  QUTHING
  THABA_TSEKA
}
